datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  admin
  front_office
  cashier
}

enum RoomStatus {
  available
  occupied
  maintenance
  dirty
  clean
}

enum ReservationStatus {
  tentative
  guaranteed
  room_assigned
  checked_in
  in_house
  due_checkout
  early_checkout
  checked_out
  completed
  closed
  no_show
  cancelled
  confirmed
  do_check_in
}

enum GuaranteeMethod {
  advance_payment
  manual
}

enum CheckoutType {
  normal
  early
}
enum BookingSource {
  direct
  travel_agent
  walk_in
  online
  booking_com
  agoda
  expedia
  airbnb
}

enum RoomCleanStatus {
  dirty
  cleaning_in_progress
  clean
  inspected
  out_of_service
}

enum HousekeepingTaskType {
  checkout_clean
  stayover_clean
  turndown
  deep_clean
  inspection
}

enum ChannelSyncDirection {
  push
  pull
}

enum ChannelSyncStatus {
  pending
  success
  failed
}

enum GroupReservationStatus {
  CONFIRMED
  PARTIALLY_CHECKED_IN
  IN_HOUSE
  PARTIALLY_CHECKED_OUT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  agent_credit
}

enum RefundMethod {
  cash
  card
  bank_transfer
  agent_credit
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentCategory {
  advance
  full
  balance
  refund
}
enum RoomTypeStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique @db.VarChar(50)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  fullName      String?        @map("full_name") @db.VarChar(100)
  // Kept for backwards compatibility with existing integrations. RBAC uses roleId.
  role          UserRole       @default(front_office)
  roleId        Int?           @map("role_id")
  rbacRole      Role?          @relation(fields: [roleId], references: [id])
  isActive      Boolean        @default(true) @map("is_active")
  mealPlanId    Int?         @map("meal_plan_id")
  mealPlan      MealPlan?    @relation(fields: [mealPlanId], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  
  reservations          Reservation[]           @relation("CreatedReservations")
  cancelledReservations Reservation[]           @relation("CancelledReservations")
  updatedReservations   Reservation[]           @relation("UpdatedReservations")
  complimentaryApprovals Reservation[]        @relation("ComplimentaryApprovals")
  payments              Payment[]
  invoices              TravelAgentTaxInvoice[]
  guestCharges          GuestCharge[]
  nightAudits           NightAudit[]
   refunds               Refund[]
   discounts             Discount[]
   roomMaintenances      RoomMaintenance[]
   auditLogs             AuditLog[]
   housekeepingStaff     HousekeepingStaff[]
   createdHousekeepingTasks HousekeepingTask[]

   @@map("users")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(100)
  name        String    @db.VarChar(100)
  module      String    @db.VarChar(50)
  action      String    @db.VarChar(50)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Guest {
  id            Int            @id @default(autoincrement())
  fullName      String         @map("full_name") @db.VarChar(150)
  phone         String?        @db.VarChar(30)
  email         String?        @db.VarChar(150)
  nationality   String?        @db.VarChar(80)
  idPassportNo  String?        @map("id_passport_no") @db.VarChar(50)
  address       String?        @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(0)

  reservations  Reservation[]

  @@map("guests")
}

model TravelAgent {
  id             Int               @id @default(autoincrement())
  agentName      String            @map("agent_name") @db.VarChar(150)
  contactPerson  String?           @map("contact_person") @db.VarChar(100)
  phone          String?           @db.VarChar(30)
  email          String?           @db.VarChar(150)
  commissionRate Float             @default(0) @map("commission_rate")
  isActive       Boolean           @default(true) @map("is_active")

  ratePlans      RatePlan[]
  reservations   Reservation[]
  groupReservations GroupReservation[]

  @@map("travel_agents")
}

model RoomType {
  id               Int            @id @default(autoincrement())
  typeName         String         @map("type_name") @db.VarChar(80)
  code             String         @unique @db.VarChar(20)
  description      String?        @db.VarChar(255)
  maxOccupancy     Int            @default(2) @map("max_occupancy")
  numberOfAdults   Int?           @map("number_of_adults")
  numberOfChildren Int?           @map("number_of_children")
  baseRate         Decimal        @map("base_rate") @db.Decimal(12,2)
  status           RoomTypeStatus @default(ACTIVE) @map("status")
  // optional extensions
  bedType          String?        @db.VarChar(50)
  numberOfBeds     Int?
  roomSize         String?        @db.VarChar(50)
  amenities        Json?
  imageUrl         String?        @db.VarChar(255)
  displayOrder     Int?           @default(0)

  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamp(0)

  rooms        Room[]
  ratePlans    RatePlan[]
  channelRateAvailability ChannelRateAvailability[]

  @@map("room_types")
}

model Room {
  id           Int          @id @default(autoincrement())
  roomNumber   String       @unique @map("room_number") @db.VarChar(10)
  roomTypeId   Int          @map("room_type_id")
  floorId      Int?         @map("floor_id")
  status       RoomStatus   @default(available)
  propertyId   Int          @default(1) @map("property_id")
  cleanStatus  RoomCleanStatus @default(dirty) @map("clean_status")

  roomType     RoomType     @relation(fields: [roomTypeId], references: [id])
  floor        Floor?       @relation(fields: [floorId], references: [id])
  reservations Reservation[]
  maintenances RoomMaintenance[]
  housekeepingTasks HousekeepingTask[]

  @@map("rooms")
}

model RatePlan {
  id            Int          @id @default(autoincrement())
  roomTypeId    Int          @map("room_type_id")
  travelAgentId Int?         @map("travel_agent_id")
  mealPlanId    Int?         @map("meal_plan_id")
  bookingSource BookingSource? @map("booking_source")
  rate           Float
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date

  roomType      RoomType     @relation(fields: [roomTypeId], references: [id])
  travelAgent   TravelAgent? @relation(fields: [travelAgentId], references: [id])
  mealPlan      MealPlan?    @relation(fields: [mealPlanId], references: [id])

  @@map("rate_plans")
  @@unique([roomTypeId, travelAgentId, mealPlanId, bookingSource])
}

model GroupReservation {
  id                    Int                    @id @default(autoincrement())
  groupCode             String                 @unique @map("group_code") @db.VarChar(30)
  groupName             String                 @map("group_name") @db.VarChar(150)
  travelAgentId         Int?                   @map("travel_agent_id")
  checkInDate           DateTime               @map("check_in_date") @db.Date
  checkOutDate          DateTime               @map("check_out_date") @db.Date
  expectedCheckInAt     DateTime?              @map("expected_check_in_at") @db.Timestamp(0)
  expectedCheckOutAt    DateTime?              @map("expected_check_out_at") @db.Timestamp(0)
  mealPlanId            Int?                   @map("meal_plan_id")
  ratePlanId            Int?                   @map("rate_plan_id")
  status                GroupReservationStatus @default(CONFIRMED) @map("status")
  notes                 String?                @map("notes") @db.Text
  createdBy             Int?                   @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime?              @updatedAt @map("updated_at") @db.Timestamp(0)

  travelAgent           TravelAgent?           @relation(fields: [travelAgentId], references: [id])
  reservations          Reservation[]          @relation("GroupReservations")

  @@map("group_reservations")
}

model Reservation {
  id                 Int               @id @default(autoincrement())
  confoNo            String            @unique @map("confo_no") @db.VarChar(30)
  guestId            Int               @map("guest_id")
  travelAgentId      Int?              @map("travel_agent_id")
  roomId             Int?              @map("room_id")
  groupReservationId Int?              @map("group_reservation_id")
      checkIn        DateTime   @map("check_in")
    checkOut       DateTime   @map("check_out")
    adults         Int        @default(1) @map("adults")
    children       Int        @default(0) @map("children")
    status         ReservationStatus @default(tentative) @map("status")
    bookingSource  BookingSource? @map("booking_source")
    rate           Float      @map("rate")
    // Guarantee tracking
  guarantee_method   GuaranteeMethod?   @map("guarantee_method")
  guarantee_reason   String?               @map("guarantee_reason")
  guaranteed_at      DateTime?             @map("guaranteed_at")
  guaranteed_by      Int?                  @map("guaranteed_by")
  // Check-in/out details
  checked_in_by      Int?                  @map("checked_in_by")
  checkout_type      CheckoutType      @map("checkout_type") @default(normal)
  checkout_reason    String?               @map("checkout_reason")
  checked_out_by     Int?                  @map("checked_out_by")

  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  propertyId         Int               @default(1) @map("property_id")
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamp(0)
  cancelledBy        Int?              @map("cancelled_by")
  updatedAt          DateTime?         @updatedAt @map("updated_at") @db.Timestamp(0)
  updatedBy          Int?              @map("updated_by")
  checkedInAt        DateTime?         @map("checked_in_at") @db.Timestamp(0)
  checkedOutAt       DateTime?         @map("checked_out_at") @db.Timestamp(0)
  expectedCheckInAt  DateTime?         @map("expected_check_in_at") @db.Timestamp(0)
  expectedCheckOutAt DateTime?         @map("expected_check_out_at") @db.Timestamp(0)
  dueDate            DateTime?         @map("due_date") @db.Date
  originalCheckOut   DateTime?         @map("original_check_out") @db.Timestamp(0)
  earlyCheckoutAt    DateTime?         @map("early_checkout_at") @db.Timestamp(0)
  noShowAt           DateTime?         @map("no_show_at") @db.Timestamp(0)
  noShowBy           Int?              @map("no_show_by")
  isComplimentary    Boolean           @default(false) @map("is_complimentary")
  complimentaryReason String?          @map("complimentary_reason") @db.VarChar(255)
  complimentaryApprovedBy Int?        @map("complimentary_approved_by")

  guest              Guest             @relation(fields: [guestId], references: [id])
  travelAgent        TravelAgent?      @relation(fields: [travelAgentId], references: [id])
  room               Room?              @relation(fields: [roomId], references: [id])
  groupReservation   GroupReservation?  @relation("GroupReservations", fields: [groupReservationId], references: [id])

  createdBy          Int?               @map("created_by")
  user               User?             @relation("CreatedReservations", fields: [createdBy], references: [id])
  cancelledUser      User?             @relation("CancelledReservations", fields: [cancelledBy], references: [id])
  updatedUser        User?             @relation("UpdatedReservations", fields: [updatedBy], references: [id])
  complimentaryApprover User?          @relation("ComplimentaryApprovals", fields: [complimentaryApprovedBy], references: [id])
  payments           Payment[]
  guestCharges       GuestCharge[]
  refunds            Refund[]
  discounts          Discount[]

  // Meal plan snapshot fields (copied from RatePlan.mealPlan at booking time)
  mealPlanId         Int?              @map("meal_plan_id")
  mealPlanCode       String?           @map("meal_plan_code") @db.VarChar(10)
  mealPlanName       String?           @map("meal_plan_name") @db.VarChar(150)
  mp_breakfast_inc   Boolean?          @map("mp_breakfast_inc")
  mp_lunch_inc       Boolean?          @map("mp_lunch_inc")
  mp_dinner_inc      Boolean?          @map("mp_dinner_inc")
  mp_drinks_inc      Boolean?          @map("mp_drinks_inc")
  mp_snacks_inc      Boolean?          @map("mp_snacks_inc")
  hb_selection       String?           @map("hb_selection") @db.VarChar(20)

  @@map("reservations")
}

model Payment {
  id            Int         @id @default(autoincrement())
  reservationId Int         @map("reservation_id")
  amount        Float
  paymentMethod   PaymentMethod @map("payment_method")
  paymentCategory PaymentCategory @default(balance) @map("payment_category")
  paidAt        DateTime    @default(now()) @map("paid_at") @db.Timestamp(0)
  userId        Int?        @map("user_id")
  reference     String?     @map("reference") @db.VarChar(100)

  reservation   Reservation @relation(fields: [reservationId], references: [id])
  user          User?       @relation(fields: [userId], references: [id])
  refunds       Refund[]

  @@index([reference])
  @@map("payments")
}

model TravelAgentTaxInvoice {
  id          Int      @id @default(autoincrement())
  confoNo     String   @map("confo_no") @db.VarChar(30)
  roomRevenue Float    @map("room_revenue")
  paymentType Int?     @map("payment_type")
  amount      Float
  vat         Float    @default(0)
  sc          Float    @default(0)
  tdl         Float    @default(0)
  nbt         Float    @default(0)
  userId      Int?     @map("user_id")
  invoiceDate DateTime @default(now()) @map("invoice_date") @db.Timestamp(0)
  isActive    Boolean  @default(true) @map("is_active")
  propertyId  Int      @default(1) @map("property_id")

  user        User?    @relation(fields: [userId], references: [id])

  @@map("travel_agent_tax_invoice")
}

enum TaxType {
  VAT
  SC
  TDL
  NBT
}

enum CompoundOn {
  room_revenue
  room_revenue_plus_sc
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model TaxConfig {
  id             Int              @id @default(autoincrement())
  taxType        TaxType          @map("tax_type")
  rate           Float
  compoundOn     CompoundOn       @default(room_revenue) @map("compound_on")
  effectiveFrom  DateTime         @map("effective_from") @db.Date
  effectiveTo    DateTime?        @map("effective_to") @db.Date
  propertyId     Int              @default(1) @map("property_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  guestChargeTaxes GuestChargeTax[]

  @@index([propertyId, taxType, effectiveFrom, effectiveTo])
  @@map("tax_config")
}

model ChargeType {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(100)
  defaultAccount String?        @map("default_account") @db.VarChar(20)
  guestCharges   GuestCharge[]

  @@map("charge_types")
}

model GuestCharge {
  id            Int               @id @default(autoincrement())
  reservationId Int               @map("reservation_id")
  chargeTypeId  Int               @map("charge_type_id")
  description   String?           @db.VarChar(255)
  amount        Float
  postedBy      Int               @map("posted_by")
  postedAt      DateTime          @default(now()) @map("posted_at") @db.Timestamp(0)
  isVoid        Boolean           @default(false) @map("is_void")
  voidReason    String?           @map("void_reason") @db.VarChar(255)

  reservation   Reservation       @relation(fields: [reservationId], references: [id])
  chargeType    ChargeType        @relation(fields: [chargeTypeId], references: [id])
  user          User              @relation(fields: [postedBy], references: [id])
  taxes         GuestChargeTax[]
  discounts     Discount[]

  @@map("guest_charges")
}

model MealPlan {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(10)
  name             String   @db.VarChar(150)
  description      String?  @db.VarChar(255)
  breakfastIncluded Boolean @default(false) @map("breakfast_included")
  lunchIncluded     Boolean @default(false) @map("lunch_included")
  dinnerIncluded    Boolean @default(false) @map("dinner_included")
  drinksIncluded    Boolean @default(false) @map("drinks_included")
  snacksIncluded    Boolean @default(false) @map("snacks_included")
  isActive          Boolean @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  ratePlans         RatePlan[]
  users             User[]

  @@map("meal_plans")
}

model GuestChargeTax {
  id            Int         @id @default(autoincrement())
  guestChargeId Int         @map("guest_charge_id")
  taxConfigId   Int?        @map("tax_config_id")
  taxType       TaxType     @map("tax_type")
  amount        Float
  taxRate       Float?      @map("tax_rate")
  taxableAmount Float?      @map("taxable_amount")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp(0)

  charge        GuestCharge @relation(fields: [guestChargeId], references: [id], onDelete: Cascade)
  taxConfig     TaxConfig?  @relation(fields: [taxConfigId], references: [id])

  @@map("guest_charge_tax")
}

model Floor {
  id          Int      @id @default(autoincrement())
  floorName   String   @map("floor_name") @db.VarChar(50)
  floorNumber Int      @map("floor_number")
  propertyId  Int      @default(1) @map("property_id")
  isActive    Boolean  @default(true) @map("is_active")
  rooms       Room[]

  @@unique([propertyId, floorNumber], name: "uniq_floor_per_property")
  @@map("floors")
}

model NightAudit {
  id                 Int       @id @default(autoincrement())
  auditDate          DateTime  @unique @map("audit_date") @db.Date
  completed          Boolean   @default(false) @map("completed")
  completedBy        Int?      @map("completed_by")
  completedAt        DateTime? @map("completed_at") @db.Timestamp(0)
  roomRevenuePosted  Boolean   @default(false) @map("room_revenue_posted")
  loggedOutUsers     Boolean   @default(false) @map("logged_out_users")
  tentativeReviewed  Int       @default(0) @map("tentative_reviewed")
  autoCancelled      Int       @default(0) @map("auto_cancelled")
  guaranteedReviewed Int       @default(0) @map("guaranteed_reviewed")
  autoNoShow         Int       @default(0) @map("auto_no_show")
  errorsCount        Int       @default(0) @map("errors_count")
  details            Json?     @map("details")

  user              User?     @relation(fields: [completedBy], references: [id])

  @@map("night_audit")
}


model Refund {
  id            Int          @id @default(autoincrement())
  reservationId Int          @map("reservation_id")
  paymentId     Int?         @map("payment_id")
  amount        Float
  refundMethod  RefundMethod? @default(cash) @map("refund_method")
  reference     String?      @map("reference") @db.VarChar(100)
  reason        String?      @db.VarChar(255)
  status        RefundStatus @default(PENDING) @map("status")
  refundDate    DateTime     @default(now()) @map("refund_date") @db.Timestamp(0)
  processedBy   Int?         @map("processed_by")
  processedAt   DateTime?    @map("processed_at") @db.Timestamp(0)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)

  reservation   Reservation  @relation(fields: [reservationId], references: [id])
  payment       Payment?     @relation(fields: [paymentId], references: [id])
  user          User?        @relation(fields: [processedBy], references: [id])

  @@index([reservationId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model Discount {
  id             Int          @id @default(autoincrement())
  reservationId  Int          @map("reservation_id")
  guestChargeId  Int?         @map("guest_charge_id")
  originalAmount Float        @map("original_amount")
  discountAmount Float        @map("discount_amount")
  discountType   DiscountType @default(FIXED) @map("discount_type")
  reason         String?      @db.VarChar(255)
  appliedBy      Int          @map("applied_by")
  appliedAt      DateTime     @default(now()) @map("applied_at") @db.Timestamp(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  reservation    Reservation  @relation(fields: [reservationId], references: [id])
  guestCharge    GuestCharge? @relation(fields: [guestChargeId], references: [id])
  user           User         @relation(fields: [appliedBy], references: [id])

  @@index([reservationId])
  @@index([guestChargeId])
  @@map("discounts")
}

model RoomMaintenance {
  id          Int      @id @default(autoincrement())
  roomId      Int      @map("room_id")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  status      String   @default("maintenance") @db.VarChar(50)
  reason      String?  @db.VarChar(255)
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  room        Room     @relation(fields: [roomId], references: [id])
  user        User     @relation(fields: [createdBy], references: [id])

  @@map("room_maintenance")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String   @db.VarChar(50)
  module      String   @db.VarChar(50)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    Int      @map("entity_id")
  description String?  @db.VarChar(255)
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model HousekeepingStaff {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  name        String   @db.VarChar(100)
  phone       String?  @db.VarChar(30)
  shift       String?  @db.VarChar(30)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User?                 @relation(fields: [userId], references: [id])
  assignments     HousekeepingTask[]
  attendance      HousekeepingAttendance[]

  @@map("housekeeping_staff")
}

model HousekeepingTask {
  id          Int                   @id @default(autoincrement())
  roomId      Int                   @map("room_id")
  staffId     Int?                  @map("staff_id")
  taskType    HousekeepingTaskType  @map("task_type")
  scheduledFor DateTime             @map("scheduled_for") @db.Date
  startedAt   DateTime?             @map("started_at") @db.Timestamp(0)
  completedAt DateTime?             @map("completed_at") @db.Timestamp(0)
  status      String                @default("pending") @db.VarChar(30)
  notes       String?               @db.VarChar(255)
  createdBy   Int                   @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  room         Room                  @relation(fields: [roomId], references: [id])
  staff        HousekeepingStaff?    @relation(fields: [staffId], references: [id])
  creator      User                  @relation(fields: [createdBy], references: [id])
  checklist    HousekeepingChecklistItem[]

  @@map("housekeeping_tasks")
}

model HousekeepingChecklistItem {
  id          Int              @id @default(autoincrement())
  taskId      Int              @map("task_id")
  label       String           @db.VarChar(150)
  isChecked   Boolean          @default(false) @map("is_checked")

  task        HousekeepingTask @relation(fields: [taskId], references: [id])

  @@map("housekeeping_checklist_items")
}

model HousekeepingAttendance {
  id          Int               @id @default(autoincrement())
  staffId     Int               @map("staff_id")
  date        DateTime          @db.Date
  clockIn     DateTime?         @map("clock_in") @db.Timestamp(0)
  clockOut    DateTime?         @map("clock_out") @db.Timestamp(0)

  staff       HousekeepingStaff @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@map("housekeeping_attendance")
}

model Channel {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  code          String   @unique @db.VarChar(30)
  isActive      Boolean  @default(true) @map("is_active")
  apiEndpoint   String?  @map("api_endpoint") @db.VarChar(255)
  credentialRef String?  @map("credential_ref") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  rateAvailability ChannelRateAvailability[]
  syncLogs         ChannelSyncLog[]

  @@map("channels")
}

model ChannelRateAvailability {
  id           Int      @id @default(autoincrement())
  channelId    Int      @map("channel_id")
  roomTypeId   Int      @map("room_type_id")
  date         DateTime @db.Date
  rate         Float?
  availability Int?
  isClosed     Boolean  @default(false) @map("is_closed")
  updatedAt    DateTime @updatedAt @map("updated_at")

  channel      Channel  @relation(fields: [channelId], references: [id])
  roomType     RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([channelId, roomTypeId, date])
  @@map("channel_rate_availability")
}

model ChannelSyncLog {
  id         Int                 @id @default(autoincrement())
  channelId  Int                 @map("channel_id")
  direction  ChannelSyncDirection
  status     ChannelSyncStatus   @default(pending)
  message    String?             @db.Text
  startedAt  DateTime            @default(now()) @map("started_at")
  finishedAt DateTime?           @map("finished_at")

  channel    Channel             @relation(fields: [channelId], references: [id])

  @@map("channel_sync_logs")
}
